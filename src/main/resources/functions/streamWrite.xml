<!--
  Only valid inside a <streamPipeline>. See streamRead.xml. The binding is held for the whole of
  consume(), because everything upstream of a sink executes inside it.
-->
<template xmlns="http://ws.apache.org/ns/synapse" name="streamWrite">
    <parameter name="path" description="Path to write to, relative to the connection's working directory"/>
    <sequence>
        <class name="org.wso2.carbon.connector.operations.StreamWrite"/>
    </sequence>
</template>
