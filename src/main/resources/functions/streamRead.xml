<!--
  Only valid inside a <streamPipeline>. The pipeline resolves this element to this template, takes the
  StreamSource out of the class mediator below, and drives it directly — it does not mediate the
  template. The parameters are bound onto the message for the duration of the operator's open() call,
  which is the ordinary connector way and is why StreamRead reads them from the message.
-->
<template xmlns="http://ws.apache.org/ns/synapse" name="streamRead">
    <parameter name="path" description="Path to the file to read, relative to the connection's working directory"/>
    <parameter name="offset" description="Byte offset to begin reading from. Defaults to 0"/>
    <sequence>
        <class name="org.wso2.carbon.connector.operations.StreamRead"/>
    </sequence>
</template>
